# Copy to .env; keep .env private. Node 24 loads it from apps/api.
# Ordinary mode has no synthetic login or transfer simulation. Wallet auth is opt-in.
NETWORK_MODE=testnet
ISSUER_MODE=demo
# IZIPAY Business card issuer (ISSUER_MODE=izipay). Keys come from the IZIPAY dashboard, never from the repo.
# Sandbox keys start with izpk_test_; a live izpk_live_ key also needs IZIPAY_ALLOW_LIVE=true.
# Top-ups with izipay: the on-chain payment goes to TOP_UP_RECIPIENT_ADDRESS, then the card is loaded
# from the IZIPAY account balance (keep it funded). The quote estimates IZIPAY's fee from these two values.
# IZIPAY_API_KEY=
# IZIPAY_SIGNING_SECRET=
# IZIPAY_CARDHOLDER_EMAIL_DOMAIN=cards.example.com
# Shared with the Cloudflare Email Routing worker that forwards cardholder mail (payment codes), see docs/card-mail.md.
# CARD_MAIL_SECRET=
# Reown (WalletConnect) project ID for the website wallet list (public; 32 hex characters). Also add the site origin in the Reown dashboard.
# REOWN_PROJECT_ID=
# Personal deposit addresses: account-level extended PUBLIC key (xpub of m/44'/60'/0'), never the seed. Needs top-ups configured.
# DEPOSIT_XPUB=
# IZIPAY_CARD_TYPE=visa
# IZIPAY_TOPUP_FEE_BPS=300
# IZIPAY_TOPUP_FIXED_FEE_CENTS=170
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://crypto_card:local_only_change_me@127.0.0.1:5432/crypto_card
# Explicitly enable the loopback-only screen fixture API with NETWORK_MODE=fixture.
# Fixture sessions are isolated, expiring synthetic users; no blockchain is contacted.

# Set true only with the actual approved testnet and HTTPS deployment metadata below.
WALLET_AUTH_ENABLED=false
# SIWE_ORIGIN=https://your-approved-host.example
# SIWE_URI=https://your-approved-host.example/sign-in
# AUTH_CHAIN_IDS=84532
# Public Base Sepolia endpoint (rate-limited). Replace with a private provider URL (Alchemy/Infura) later.
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# ETHEREUM_SEPOLIA_RPC_URL=https://your-other-approved-rpc.example/private-provider-key
# Keep RPC credentials only in local .env or the hosting secret store.

# Testnet top-ups (Base Sepolia USDC). Requires WALLET_AUTH_ENABLED=true and AUTH_CHAIN_IDS including 84532.
TOP_UP_ENABLED=false
# Circle's official Base Sepolia test USDC (6 decimals), see https://developers.circle.com/stablecoins/usdc-contract-addresses
# BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# A testnet address you control that receives demo top-ups. Never a real issuer address.
# TOP_UP_RECIPIENT_ADDRESS=0xYourTestnetAddress
# Blocks required before a transfer counts (default 5).
# TOP_UP_CONFIRMATIONS=5
# Our own fee on each top-up in basis points (100 = 1%), kept by the operator.
# TOP_UP_SERVICE_FEE_BPS=0
# Other supported testnet for sign-in and top-ups: Robinhood Chain Testnet (46630; its mainnet 4663 is refused).
# AUTH_CHAIN_IDS=46630
# ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# TOP_UP_CHAIN_ID=46630
# TOP_UP_TOKEN_ADDRESS=0xTestTokenWithSixDecimals
# TOP_UP_TOKEN_SYMBOL=USDC
# Optional fixed DemoIssuer notification secret (>= 32 chars). Without it a per-process key is used.
# DEMO_ISSUER_WEBHOOK_SECRET=

# Real networks (real money). Off unless BOTH are set; a test server can never reach them.
# NETWORK_MODE=mainnet
# MAINNET_ENABLED=true
# AUTH_CHAIN_IDS=137,56
# POLYGON_RPC_URL=https://your-polygon-rpc.example/
# BSC_RPC_URL=https://your-bsc-rpc.example/
# TOP_UP_ENABLED=true
# Refill stablecoins from the fixed list in src/chain/networks.ts (verify contracts on the explorer first):
# TOP_UP_ASSETS=137:USDT,56:USDT
# TOP_UP_RECIPIENT_ADDRESS=0xTheCustomersReceivingAddress
# TOP_UP_SERVICE_FEE_BPS=0
# With IZIPAY live: ISSUER_MODE=izipay, IZIPAY_API_KEY=izpk_live_..., IZIPAY_ALLOW_LIVE=true
