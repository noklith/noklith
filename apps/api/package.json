{
  "name": "crypto-card-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev:fixture": "node src/dev/fixture-server.ts",
    "smoke:fixture": "node src/dev/smoke-fixture.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate-cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "postal-mime": "4.0.4",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
