{
	servers {
		# Cloudflare ranges, generated by deploy/update-cloudflare-ips.sh. Only these peers may set the client IP.
		import /etc/caddy/shared/cloudflare-trusted-proxies.caddy
		client_ip_headers CF-Connecting-IP
	}
}

api.noklith.com {
	tls {
		issuer acme {
			# Behind the Cloudflare proxy only HTTP-01 reaches the origin; TLS-ALPN does not.
			disable_tlsalpn_challenge
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# Reown domain verification file, placed by the operator in shared/caddy/reown/ (404 until then).
	handle /.well-known/walletconnect.txt {
		root * /etc/caddy/shared/reown
		rewrite * /walletconnect.txt
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			# Replace, not append: the API sees exactly the client IP Caddy resolved from CF-Connecting-IP.
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# Website and account dashboard. The dashboard calls the API on this same origin (/v1/...),
# so sign-in messages and sessions are bound to https://noklith.com (SIWE_ORIGIN).
noklith.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The dashboard shows card details: it must never be framed by another site.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
	}
	# Reown domain verification for wallet connections from noklith.com (same operator-placed file).
	handle /.well-known/walletconnect.txt {
		root * /etc/caddy/shared/reown
		rewrite * /walletconnect.txt
		file_server
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		root * /srv/web
		file_server
		header /*.html Cache-Control "no-cache"
	}
}
